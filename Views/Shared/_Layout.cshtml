<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Запись на мойку</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand" asp-controller="CarWash" asp-action="Index">Запись на мойку</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="ms-auto d-flex align-items-center gap-3">
                    <span class="text-white-50 small d-none d-sm-inline">Пользователь: @User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="btn btn-outline-light btn-sm">Выйти</button>
                    </form>
                </div>
            }
            else
            {
                <a class="btn btn-outline-light btn-sm ms-auto" asp-controller="Account" asp-action="Login">Войти</a>
            }
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="border-top py-3 mt-4 bg-white"></footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
 </body>
</html>
