@model CarWashIndexViewModel
@{
    ViewData["Title"] = "Выбор мойки";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h4 mb-0">Выбор адреса мойки</h1>
    <span class="badge text-bg-light border">Показано адресов: @Model.CarWashes.Count</span>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="row g-3">
    @foreach (var wash in Model.CarWashes)
    {
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column">
                    <h2 class="h6 mb-1">@wash.Name</h2>
                    <p class="mb-2 text-secondary">@wash.Address</p>

                    @if (wash.NearestSlot.HasValue)
                    {
                        <div class="slot-pill mb-3">
                            Ближайшее время: <b>@wash.NearestSlot.Value.ToString("HH:mm")</b>
                        </div>
                    }
                    else
                    {
                        <div class="slot-pill slot-pill-empty mb-3">Нет свободных слотов</div>
                    }

                    <a asp-action="Slots" asp-route-id="@wash.Id" class="btn btn-primary mt-auto">Выбрать время</a>
                </div>
            </div>
        </div>
    }
</div>

<div class="card border-0 shadow-sm mt-4">
    <div class="card-body">
        <h2 class="h6 mb-3">Текущая запись</h2>
        @if (Model.CurrentBooking == null)
        {
            <p class="text-muted mb-0">Активной записи нет.</p>
        }
        else
        {
            <p class="mb-1"><b>@Model.CurrentBooking.CarWashName</b></p>
            <p class="text-secondary mb-2">@Model.CurrentBooking.CarWashAddress</p>
            <p class="mb-3">Время: <b>@Model.CurrentBooking.StartTime.ToString("HH:mm")</b></p>
            <form asp-action="CancelBooking" method="post">
                <input type="hidden" name="bookingId" value="@Model.CurrentBooking.BookingId" />
                <button class="btn btn-outline-danger">Отменить запись</button>
            </form>
        }
    </div>
</div>
