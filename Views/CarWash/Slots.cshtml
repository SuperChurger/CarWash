@model CarWashSlotsViewModel
@{
    ViewData["Title"] = "Выбор времени";
}

<h1 class="h4 mb-1">Запись на мойку</h1>
<p class="text-muted mb-1"><b>@Model.CarWashName</b></p>
<p class="text-muted mb-3">@Model.CarWashAddress</p>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (!Model.Slots.Any(s => !s.IsBooked))
{
    <div class="alert alert-warning">На ближайшие 12 часов свободных окон нет.</div>
}
else
{
    <p class="small text-muted mb-2">Интервалы на ближайшие 12 часов (шаг 15 минут):</p>
    <div class="row g-2">
        @foreach (var slot in Model.Slots)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <form asp-action="Book" method="post">
                    <input type="hidden" name="carWashId" value="@Model.CarWashId" />
                    <input type="hidden" name="startTicks" value="@slot.StartTime.Ticks" />
                    <button class="btn w-100 slot-btn @(slot.IsBooked ? "btn-secondary" : "btn-outline-primary")" disabled="@slot.IsBooked">
                        @slot.StartTime.ToString("HH:mm")
                    </button>
                </form>
            </div>
        }
    </div>
}

<a asp-action="Index" class="btn btn-link mt-3 px-0">Назад к адресам</a>
